# Runtime
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Required persistent storage. No in-memory fallback is supported.
DATABASE_URL=postgresql://sutra_user:change-me@localhost:5432/sutra
DATABASE_SSL=false

# Required live rail provider. The adapter expects JSON for trip state and disruption polling.
RAIL_PROVIDER_BASE_URL=https://your-rail-provider.example.com
RAIL_PROVIDER_API_KEY=replace-me
RAIL_PROVIDER_TRIP_PATH=/v1/trips/{externalTripId}
RAIL_PROVIDER_DISRUPTIONS_PATH=/v1/trips/{externalTripId}/disruptions
RAIL_PROVIDER_CANDIDATES_PATH=/v1/trips/{externalTripId}/recovery-options
RAIL_PROVIDER_TIMEOUT_MS=8000

# AI ranking is optional only as a controlled, explicitly labelled fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
AI_REQUIRED=false

# Browser/API access
FRONTEND_ORIGIN=http://localhost:3000
