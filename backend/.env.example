# Offline reproducible mode (no database, railway provider, or AI key required)
NODE_ENV=development
PORT=4000
DATA_MODE=fixture
STORAGE_MODE=memory
FIXTURE_TRIP_ID=trip-golden-rail-delay-01
FRONTEND_ORIGIN=http://localhost:3000
AI_PROVIDER=none
AI_TIMEOUT_MS=5000

# Optional AI ranking. Failure always falls back to deterministic ranking.
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4o-mini

# Live mode only: set DATA_MODE=live and provide all of these.
# RAIL_PROVIDER_BASE_URL=https://your-rail-provider.example.com
# RAIL_PROVIDER_API_KEY=replace-me
# RAIL_PROVIDER_TRIP_PATH=/v1/trips/{externalTripId}
# RAIL_PROVIDER_DISRUPTIONS_PATH=/v1/trips/{externalTripId}/disruptions
# RAIL_PROVIDER_CANDIDATES_PATH=/v1/trips/{externalTripId}/recovery-options
# RAIL_PROVIDER_TIMEOUT_MS=8000

# PostgreSQL persistence is optional and not used by the offline fixture.
# STORAGE_MODE=postgres  # required for real signup/login
# DATABASE_URL=postgresql://sutra_user:change-me@localhost:5432/sutra
# DATABASE_SSL=false
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=true
